# Copy to .env and fill in real values. NEVER commit .env.

# Database — Supabase PostgreSQL. Use an isolated Supabase development or
# test project for local development.
# Transaction pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct:            postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# JWT — REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Public site URL (used for Paystack callback)
NEXT_PUBLIC_SITE_URL=http://localhost:4028
NEXT_PUBLIC_API_URL=http://localhost:4028/api
NEXT_PUBLIC_SUPPORT_PHONE=

# Seed admin (used by prisma/seed.ts; required in production)
SEED_ADMIN_EMAIL=admin@247sparkle.com
SEED_ADMIN_PASSWORD=

# Cloudinary (for rider & partner photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email via Resend (optional — password-reset emails are only
# delivered when this is set; without it the reset flow still issues tokens)
RESEND_API_KEY=
EMAIL_FROM=247Sparkle <no-reply@247sparkle.com>
