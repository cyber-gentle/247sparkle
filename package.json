{
  "name": "sparkle247",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 4028",
    "build": "prisma generate && cross-env NODE_ENV=production next build",
    "start": "next start -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,md,json}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,md,json}\" \"*.{ts,mjs,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:reset": "node scripts/run-integration-tests.mjs --reset",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.0.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.21.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "next": "^15.1.11",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "prisma": "^5.21.1",
    "react": "^19.0.3",
    "react-dom": "^19.0.3",
    "react-hook-form": "^7.73.1",
    "react-qr-code": "^2.2.0",
    "recharts": "^2.15.2",
    "sonner": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
